{
  "name": "kuwait-feedback-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db supabase/tests/database.test.sql supabase/tests/survey_management.test.sql supabase/tests/analytics_workflows.test.sql supabase/tests/team_settings_platform.test.sql",
    "db:test:authorization": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres --set=ON_ERROR_STOP=1 --file=supabase/tests/rls_verification.sql",
    "db:test:performance": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres --file=supabase/tests/analytics_performance.sql",
    "db:types": "supabase gen types --lang typescript --local > src/types/database.ts",
    "db:verify:native": "sh scripts/verify-local-database.sh",
    "db:validate:migrations": "sh scripts/validate-migration-order.sh",
    "security:secrets": "sh scripts/scan-secrets.sh",
    "security:client-boundary": "vitest run src/lib/security/client-boundary.test.ts",
    "test:localization": "vitest run src/lib/i18n/messages.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.20"
  }
}
