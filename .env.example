# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# local, preview, or production. Preview/prod must use a matching isolated project.
APP_ENV=local
SUPABASE_PROJECT_ENVIRONMENT=local
SUPABASE_PROJECT_REF=replace-with-project-ref-for-hosted-environments

# Server-only configuration. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Server-only HMAC secret for short-lived anonymous request fingerprints
SUBMISSION_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters

# IANA timezone used for business reporting and presentation
APP_TIME_ZONE=Asia/Kuwait

# Server-only transactional email configuration. Local development uses Mailpit.
EMAIL_DELIVERY_MODE=preview
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=replace-with-smtp-port
SMTP_SECURE=false
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=replace-with-sender@example.test
SMTP_FROM_NAME=replace-with-sender-name

# Server-only bot-protection configuration. Keep disabled only for local development.
BOT_PROTECTION_PROVIDER=disabled
BOT_PROTECTION_SITE_KEY=replace-with-public-site-key
BOT_PROTECTION_SECRET_KEY=replace-with-server-only-secret-key
BOT_PROTECTION_EXPECTED_HOSTNAME=replace-with-public-hostname
BOT_PROTECTION_EXPECTED_ACTION=public_survey_submission
BOT_PROTECTION_LOCAL_BYPASS=false

# Operational metadata. Deployment credentials are managed by the hosting provider only.
LOG_LEVEL=info
DEPLOYMENT_VERSION=replace-with-deployment-version
VERCEL_ENV=development
VERCEL_GIT_COMMIT_SHA=replace-with-commit-sha
