# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only configuration. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only HMAC secret for short-lived anonymous request fingerprints
SUBMISSION_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters

# IANA timezone used for business reporting and presentation
APP_TIME_ZONE=Asia/Kuwait

# Server-only transactional email configuration. Local development uses Mailpit.
EMAIL_DELIVERY_MODE=preview
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.test
